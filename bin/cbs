#!/usr/bin/env bash

set -Eeuo pipefail

CBS_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CBS_ROOT="$(cd "$CBS_BIN_DIR/.." && pwd)"
VERSION_FILE="$CBS_ROOT/VERSION"
CONTEXT_LIB="$CBS_ROOT/cbs/context/context.sh"
GIT_OBSERVER_LIB="$CBS_ROOT/cbs/context/git_observer.sh"
WORKSTATION_MANAGER="$CBS_ROOT/cbs/workstation/workstation_manager.sh"
WORKSPACE_OBSERVER="$CBS_ROOT/cbs/workspace/workspace_observer.sh"
WORKSPACE_MANAGER="$CBS_ROOT/cbs/workspace/workspace_manager.sh"
REPOSITORY_MANAGER="$CBS_ROOT/cbs/workspace/repository_manager.sh"
WORKTREE_OBSERVER="$CBS_ROOT/cbs/worktree/worktree_observer.sh"
WORKTREE_MANAGER="$CBS_ROOT/cbs/worktree/worktree_manager.sh"
STACK_RESOLVER="$CBS_ROOT/cbs/stack/stack_resolver.sh"
STACK_PREREQUISITE_EVALUATOR="$CBS_ROOT/cbs/stack/stack_prerequisite_evaluator.sh"
INSTANCE_OBSERVER="$CBS_ROOT/cbs/instance/instance_observer.sh"
INSTANCE_MANAGER="$CBS_ROOT/cbs/instance/instance_manager.sh"

print_help() {
    printf "%s\n" \
        "CBS Environment Framework" \
        "" \
        "Usage:" \
        "  cbs" \
        "  cbs help" \
        "  cbs --help" \
        "  cbs -h" \
        "  cbs version" \
        "  cbs --version" \
        "  cbs status <context-file>" \
        "  cbs workstation check <context-file>" \
        "  cbs workspace check <workspace-path> <repository-path> <origin>" \
        "  cbs workspace ensure <workspace-path>" \
        "  cbs repository ensure <repository-path> <origin>" \
        "  cbs worktree check <repository-path>" \
        "  cbs worktree ensure <repository-path> <worktree-path> <branch>" \
        "  cbs stack resolve <manifest>" \
        "  cbs stack prerequisites <manifest>" \
        "  cbs instance check <manifest>" \
        "  cbs instance ensure <manifest>" \
        "" \
        "Commands:" \
        "  help        Display this help." \
        "  version     Display the CBS Environment Framework version." \
        "  status      Display configured and observed context status." \
        "  workstation Check workstation prerequisites and isolation."
}

print_version() {
    if [[ ! -f "$VERSION_FILE" ]]; then
        echo "CBS_ERROR=VERSION_FILE_NOT_FOUND" >&2
        return 3
    fi

    version="$(tr -d "\r\n" < "$VERSION_FILE")"

    if [[ -z "$version" ]]; then
        echo "CBS_ERROR=VERSION_EMPTY" >&2
        return 3
    fi

    printf "CBS_FRAMEWORK_VERSION=%s\n" "$version"
}

print_status() {
    local context_file="${1:-}"

    if [[ -z "$context_file" ]]; then
        echo "CBS_ERROR=CONTEXT_FILE_REQUIRED" >&2
        return 2
    fi

    [[ -f "$CONTEXT_LIB" ]] || {
        echo "CBS_ERROR=CONTEXT_LIBRARY_NOT_FOUND" >&2
        return 3
    }

    [[ -f "$GIT_OBSERVER_LIB" ]] || {
        echo "CBS_ERROR=GIT_OBSERVER_LIBRARY_NOT_FOUND" >&2
        return 3
    }

    source "$CONTEXT_LIB"
    source "$GIT_OBSERVER_LIB"

    cbs_context_load "$context_file" || return $?
    cbs_git_observe_and_compare || return $?

    printf 'CBS_CONTEXT_CLIENT=%s\n' "$CBS_CONTEXT_CLIENT"
    printf 'CBS_CONTEXT_ENTITY_TYPE=%s\n' "$CBS_CONTEXT_ENTITY_TYPE"
    printf 'CBS_CONTEXT_ENTITY_NAME=%s\n' "$CBS_CONTEXT_ENTITY_NAME"
    printf 'CBS_CONTEXT_ENVIRONMENT=%s\n' "$CBS_CONTEXT_ENVIRONMENT"

    printf 'CBS_CONTEXT_REPOSITORY_PATH=%s\n' "$CBS_CONTEXT_REPOSITORY_PATH"
    printf 'CBS_OBSERVED_REPOSITORY_PATH=%s\n' "$CBS_OBSERVED_REPOSITORY_PATH"

    printf 'CBS_CONTEXT_BRANCH=%s\n' "$CBS_CONTEXT_BRANCH"
    printf 'CBS_OBSERVED_BRANCH=%s\n' "$CBS_OBSERVED_BRANCH"

    printf 'CBS_OBSERVED_HEAD=%s\n' "$CBS_OBSERVED_HEAD"

    printf 'CBS_CONTEXT_DRIFT=%s\n' "$CBS_CONTEXT_DRIFT"
    printf 'CBS_CONTEXT_DRIFT_REPOSITORY_PATH=%s\n' "$CBS_CONTEXT_DRIFT_REPOSITORY_PATH"
    printf 'CBS_CONTEXT_DRIFT_BRANCH=%s\n' "$CBS_CONTEXT_DRIFT_BRANCH"
}

main() {
    command="${1:-help}"

    case "$command" in
        help|--help|-h)
            print_help
            ;;
        version|--version)
            print_version
            ;;
        status)
            shift
            print_status "${1:-}"
            ;;
        workspace)
            shift
            subcommand="${1:-}"

            case "$subcommand" in
                check)
                    shift
                    "$WORKSPACE_OBSERVER"                         "${1:-}"                         "${2:-}"                         "${3:-}"
                    ;;
                ensure)
                    shift
                    "$WORKSPACE_MANAGER" "${1:-}"
                    ;;
                *)
                    echo "CBS_ERROR=UNKNOWN_WORKSPACE_COMMAND" >&2
                    echo "CBS_COMMAND=${subcommand}" >&2
                    return 2
                    ;;
            esac
            ;;

        repository)
            shift
            subcommand="${1:-}"

            case "$subcommand" in
                ensure)
                    shift
                    "$REPOSITORY_MANAGER"                         "${1:-}"                         "${2:-}"
                    ;;
                *)
                    echo "CBS_ERROR=UNKNOWN_REPOSITORY_COMMAND" >&2
                    echo "CBS_COMMAND=${subcommand}" >&2
                    return 2
                    ;;
            esac
            ;;

        workstation)
            shift

            subcommand="${1:-}"

            case "$subcommand" in
                check)
                    shift

                    if [[ ! -x "$WORKSTATION_MANAGER" ]]; then
                        echo "CBS_ERROR=WORKSTATION_MANAGER_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$WORKSTATION_MANAGER" "${1:-}"
                    ;;
                *)
                    echo "CBS_ERROR=UNKNOWN_WORKSTATION_COMMAND" >&2
                    echo "CBS_COMMAND=${subcommand}" >&2
                    return 2
                    ;;
            esac
            ;;

        worktree)
            shift
            subcommand="${1:-}"

            case "$subcommand" in
                check)
                    shift

                    if [[ ! -x "$WORKTREE_OBSERVER" ]]; then
                        echo "CBS_ERROR=WORKTREE_OBSERVER_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$WORKTREE_OBSERVER" "${1:-}"
                    ;;
                ensure)
                    shift

                    if [[ ! -x "$WORKTREE_MANAGER" ]]; then
                        echo "CBS_ERROR=WORKTREE_MANAGER_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$WORKTREE_MANAGER"                         "${1:-}"                         "${2:-}"                         "${3:-}"
                    ;;
                *)
                    echo "CBS_ERROR=UNKNOWN_WORKTREE_COMMAND" >&2
                    echo "CBS_COMMAND=${subcommand}" >&2
                    return 2
                    ;;
            esac
            ;;
        stack)
            shift
            subcommand="${1:-}"

            case "$subcommand" in
                resolve)
                    shift

                    if [[ ! -x "$STACK_RESOLVER" ]]; then
                        echo "CBS_ERROR=STACK_RESOLVER_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$STACK_RESOLVER" "${1:-}"
                    ;;
                prerequisites)
                    shift

                    if [[ ! -x "$STACK_PREREQUISITE_EVALUATOR" ]]; then
                        echo "CBS_ERROR=STACK_PREREQUISITE_EVALUATOR_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$STACK_PREREQUISITE_EVALUATOR" "${1:-}"
                    ;;
                *)
                    echo "CBS_ERROR=UNKNOWN_STACK_COMMAND" >&2
                    echo "CBS_COMMAND=${subcommand}" >&2
                    return 2
                    ;;
            esac
            ;;

        instance)
            shift
            subcommand="${1:-}"

            case "$subcommand" in
                check)
                    shift

                    if [[ ! -x "$INSTANCE_OBSERVER" ]]; then
                        echo "CBS_ERROR=INSTANCE_OBSERVER_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$INSTANCE_OBSERVER" "${1:-}"
                    ;;
                ensure)
                    shift

                    if [[ ! -x "$INSTANCE_MANAGER" ]]; then
                        echo "CBS_ERROR=INSTANCE_MANAGER_NOT_EXECUTABLE" >&2
                        return 3
                    fi

                    "$INSTANCE_MANAGER" "${1:-}"
                    ;;
                *)
                    echo "CBS_ERROR=UNKNOWN_INSTANCE_COMMAND" >&2
                    echo "CBS_COMMAND=${subcommand}" >&2
                    return 2
                    ;;
            esac
            ;;

        *)
            echo "CBS_ERROR=UNKNOWN_COMMAND" >&2
            printf "CBS_COMMAND=%s\n" "$command" >&2
            echo "Run \"cbs help\" for usage." >&2
            return 2
            ;;
    esac
}

main "$@"
